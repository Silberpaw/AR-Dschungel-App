<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/selfieLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ArSelfieActivity"
    android:background="@color/black">

    <io.github.sceneview.ar.ArSceneView
        android:id="@+id/sceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/selfieInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mach_ein_selfie_mit_deinem_tier"
        android:textSize="20sp"
        android:fontFamily="@font/comic_reg"
        android:textColor="@color/purple_700"
        android:background="@drawable/rounded_button"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnScreenshot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/foto_machen"
        android:textSize="18sp"
        android:fontFamily="@font/comic_reg"
        android:textColor="@android:color/white"
        android:icon="@drawable/baseline_camera_alt_24"
        android:iconTint="@android:color/white"
        android:backgroundTint="@color/buttonOrange"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="24dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
